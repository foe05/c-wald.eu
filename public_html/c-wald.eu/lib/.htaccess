# lib/ holds server-side PHP helpers that should never be requested directly
# over HTTP. Even without this block, the .php files here only declare
# functions and would produce no output — but be defensive.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
